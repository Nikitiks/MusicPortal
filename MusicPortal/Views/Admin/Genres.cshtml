@model List<Genre>
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["Title"];
}

<div class="row">
    <div class="col-md-6">
        <h2>@Localizer["GenreManagement"]</h2>
    </div>
    <div class="col-md-6 text-end">
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addGenreModal">
            @Localizer["AddGenre"]
        </button>
    </div>
</div>

@if (Model.Any())
{
    <div class="table-responsive mt-3">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>@Localizer["GenreName"]</th>
                    <th>@Localizer["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var genre in Model)
                {
                    <tr>
                        <td>@genre.Id</td>
                        <td>@genre.Name</td>
                        <td>
                            <form method="post" asp-action="DeleteGenre" class="d-inline" onsubmit="return confirm('@Localizer["DeleteGenreConfirm"]');">
                                <input type="hidden" name="id" value="@genre.Id" />
                                <button type="submit" class="btn btn-danger btn-sm">@Localizer["Delete"]</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info mt-3">
        @Localizer["NoGenres"]
    </div>
}

<div class="modal fade" id="addGenreModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@Localizer["AddNewGenre"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-action="AddGenre">
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="genreName" class="form-label">@Localizer["GenreName"]</label>
                        <input type="text" class="form-control" id="genreName" name="name" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                    <button type="submit" class="btn btn-primary">@Localizer["Add"]</button>
                </div>
            </form>
        </div>
    </div>
</div>