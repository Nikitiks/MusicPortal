@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    var userId = HttpContextAccessor.HttpContext?.Session.GetInt32("UserId");
    var username = HttpContextAccessor.HttpContext?.Session.GetString("Username");
    var isAdminStr = HttpContextAccessor.HttpContext?.Session.GetString("IsAdmin");
    var isAdmin = isAdminStr == "True";
}

@if (userId != null)
{
    <li class="nav-item">
        <span class="navbar-text text-light me-2">
            Вітаємо, @username!
        </span>
    </li>
    <li class="nav-item">
        <a class="nav-link" asp-controller="Account" asp-action="Logout">Вийти</a>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link" asp-controller="Account" asp-action="Login">Увійти</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" asp-controller="Account" asp-action="Register">Реєстрація</a>
    </li>
}